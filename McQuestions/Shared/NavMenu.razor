@using McQuestions.Shared.SvgComponents

<Style />
<style>
	.nav-link {
		color: black;
		padding: .2rem;
		padding-left: 2.5rem;
		font-size: 0.88rem;
		border: none;

	}

	.linkbutton {
		color: black;
		padding: .2rem;
		padding-left: 2.5rem;
		font-size: 0.88rem;
		border: none;
		width: 100%;
		height: 100%;
		text-align: left;
		background-color: !important none;
	}

	#toplink{
		padding-top: 16px;
		padding-left: 10px;
		font-size: 0.9rem;
	}

	a {
		color: black;
	}

	.nav {
		/* padding-left:10px; */
		/*font-size: 0.9rem;*/
		
        font-weight: 500;
        
	}

	button {
		background-color: none;
	}

	.oi.oi-home{
		width: 2rem;
		font-size: 0.91rem;
		vertical-align: text-top;
		top: 0px;
	}

	.oi.oi-plus {
		width: 2rem;
		font-size: 0.91rem;
		vertical-align: text-top;
		top: 0px;
	}

	.kopjenav {
		font-size: 0.88rem; 
		padding-left: 2rem;
		padding-bottom: .6rem;
		font-weight:600;
	}

</style>

<div class="top-row ps-3 navbar navbar-dark">
	<div class="container-fluid">
		<a class="navbar-brand" href="">McQuestions Demo</a>
		<button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
			<span class="navbar-toggler-icon"></span>
		</button>
	</div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
	<nav class="flex-column">
		@foreach (var link in Concept)
		{
			bool isClicked = ClickedLink == link; 
			string text = "Concept";
			<div class="nav">
				<button class="choicenavbuttons" style="margin-top:18px" @onclick="() => Navigate(link)">
					@if (isClicked) { <ArrowGoesIn /> }
					else { <Circle /> }
					@text
				</button>
			</div>
		}

		<hr />

		<div class="choicenavbuttonskopje">HR-sets</div>
		@foreach (var link in NietKennislinks)
		{
			bool isClicked = ClickedLink == link; // selectienietkennistest/{NieuweBaan.xml}
			string text = link.Replace("selectienietkennistest/{", "").Replace("}", "").Replace(".xml", "");
			<div class="nav">
				<button class="choicenavbuttons" @onclick="() => Navigate(link)">
					@if (isClicked) { <ArrowGoesIn /> }
					else { <Circle /> }
					@text
				</button>
			</div>
		}

		<hr />
		<div class="choicenavbuttonskopje">Kennissets</div>

		@foreach (var link in Kennislinks)
		{
			bool isClicked = ClickedLink == link; 
			string text = link.Replace("selectie/{", "").Replace("}", "").Replace(".xml", "");
			<div class="nav">
				<button class="choicenavbuttons" @onclick="() => Navigate(link)">
					@if (isClicked) { <ArrowGoesIn /> }
					else { <Circle /> }
					@text
				</button>
			</div>
		}

		<hr />
		<div class="choicenavbuttonskopje">Admin</div>
		@foreach (var link in Admin)
		{
			bool isClicked = ClickedLink == link;
			string text = link;
			<div class="nav">
				<button class="choicenavbuttons" @onclick="() => Navigate(link)">
					@if (isClicked)
					{
						<ArrowGoesIn />
					}
					else
					{
						<Circle />
					}
					@text
				</button>
			</div>
		}

	</nav>
</div>

@code {
	private bool collapseNavMenu = true;

	private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

	private void ToggleNavMenu()
	{

		collapseNavMenu = !collapseNavMenu;
	}

	List<string> Concept = new()
			{
				"/"
			};

	List<string> Admin = new()
			{
				"Beheer",
				"Maak",
				"McDevelopment"
			};

	List<string> NietKennislinks = new()
			{
				"selectienietkennistest/{Intake.xml}",
				"selectienietkennistest/{Nieuwe Baan.xml"
			};

	List<string> Kennislinks = new()
			{
				"selectie/{Scrum.xml}",
				"selectie/{Gegevensbescherming.xml}",
				"selectie/{General.xml}",
				"selectie/{FrontEnd.xml}",
				"selectie/{BackEnd.xml}",
				"selectie/{Javascript.xml}",
				"selectie/{C-Sharp.xml}",
				"selectie/{Python.xml}",
				"selectie/{TechBuzz.xml}"
			};

	private string? ClickedLink = null;

	[Inject] private NavigationManager? NavigationManager { get; set; }

	private void Navigate(string link)
	{
		NavigationManager!.NavigateTo(link);
		if (ClickedLink == link)
		{
			ClickedLink = null;
		}
		else
		{
			ClickedLink = link;
		}

	}
}
