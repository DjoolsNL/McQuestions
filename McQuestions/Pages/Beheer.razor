	protected override void OnInitialized()
	{
		Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory + "XmlQuestions\\");
		folderPath = Directory.GetCurrentDirectory();
		fileNames = Directory.GetFiles(folderPath);
		naamVragenSet = "Beheer Vragensets";
	}

	void OnClick(string fname)
	{
		// gekozen file inlezen
		fileName = fname;
		var xmlString = File.ReadAllText(fname);
		xElement = XElement.Parse(xmlString);

		naamVragenSet = xElement.Element("vragenset").Value + " Vragenset";
		List<XElement> elementsList = new();
		elementsList = xElement.Elements("vraag").ToList();
		
		xmlQuestions = elementsList
			.OrderBy(element => (string)element.Element("niveau"))
			.ToList();

		#region XML to OBJECT
		// data uit xml wordt gebruikt om objecten Vraag te maken 
		//foreach (var v in xmlQuestions)
		//{
		//	Vraag vraag = new();
		//	vraag.guid = v.Element("guid").Value;
		//	vraag.volgnummer = v.Element("volgnummer").Value;
		//	vraag.niveau = v.Element("niveau").Value;
		//	vraag.onderwerp = v.Element("onderwerp").Value;

		//	foreach (var regel in v.Element("header").Elements())
		//	{
		//		vraag.Header.Add(regel.Value);
		//	}

		//	foreach (var keuze in v.Element("keuzes").Elements())
		//	{
		//		vraag.Keuzes.Add(keuze.Value);
		//	}

		//	vraag.antwoord = v.Element("antwoord").Value;
		//	vraag.show = v.Element("show").Value;
		//	vraag.uitleg = v.Element("uitleg").Value;

		//	VragenLijst.Add(vraag);
		//}
		#endregion

		if (AddGuid)
		{
			foreach (var q in xElement.Elements("vraag"))
			{
				Guid g = Guid.NewGuid();
				q.Element("guid").Value = g.ToString();
			}

			xElement.Save(fname);
		}
		else
		{
			ReadyForBrowser = true;
		}	
	}

	void OnSave(string fname)
	{
		XElement doc = new XElement("root");
		XElement vragenset = new XElement("vragenset", xElement.Element("vragenset").Value);
		doc.Add(vragenset);
		//xmlQuestions.Elements().OrderBy(e => (int)e.Element("niveau"));

		foreach (var item in xmlQuestions)
		{
			XElement vraag = new XElement("vraag", item.Elements());
			doc.Add(vraag);
		}

		doc.Save(fname);
	}

	void OnDisable(string guid)
	{
		var disable = xmlQuestions.FirstOrDefault(e => e.Element("guid").Value == guid);

		if (disable.Element("disabled").Value == "true")
		{
			disable.Element("disabled").Value = "false";
		}
		else
		{
			disable.Element("disabled").Value = "true";
		}

		XElement doc = new XElement("root");
		XElement vragenset = new XElement("vragenset", xElement.Element("vragenset").Value);
		doc.Add(vragenset);

		foreach (var item in xmlQuestions)
		{
			XElement vraag = new XElement("vraag", item.Elements());
			doc.Add(vraag);
		}

		doc.Save(fileName);
	}

	void OnDelete(string guid)
	{
		int del = xmlQuestions.FindIndex(e => e.Element("guid").Value == guid);
		xmlQuestions.RemoveAt(del);
		XElement doc = new XElement("root");
		XElement vragenset = new XElement("vragenset", xElement.Element("vragenset").Value);
		doc.Add(vragenset);

		foreach (var item in xmlQuestions)
		{
			XElement vraag = new XElement("vraag", item.Elements());
			doc.Add(vraag);
		}

		doc.Save(fileName);
	}

	void OnChangeAddGuid(ChangeEventArgs e)
	{
		if (e.Value.ToString() == "true")
		{
			AddGuid = true;
		}
	}
}

<h2>@naamVragenSet</h2>
<hr />
<div class="indexdiv">

	@foreach (var filename in fileNames)
	{
		using (XmlReader reader = XmlReader.Create(filename))
		{
			while (reader.Read())
			{
				if (reader.NodeType == XmlNodeType.Element && reader.Name == "niveau")
				{
					int niveau = reader.ReadElementContentAsInt();
					switch (niveau)
					{
						case 1:
							level1++;
							break;
						case 2:
							level2++;
							break;
						case 3:
							level3++;
							break;
						case 4:
							level4++;
							break;
						case 5:
							level5++;
							break;
					}
				}
			}
		}

		<table style="display:inline; margin-left:25px; margin-top:30px">
			<tr>
				<td>
					<button @onclick="() => OnClick(filename)" class="filebutton">@Path.GetFileName(filename)</button>
					<span>&nbsp;&nbsp;</span>
				</td>
			</tr>
			<tr>
				<td>Niveau 1: @level1.ToString()</td>
			</tr>
			<tr>
				<td>Niveau 2: @level2.ToString()</td>
			</tr>
			<tr>
				<td>Niveau 3: @level3.ToString()</td>
			</tr>
			<tr>
				<td>Niveau 4: @level4.ToString()</td>
			</tr>
			<tr>
				<td>Niveau 5: @level5.ToString()</td>
			</tr>
			<tr>
				<td><b>Tot. aantal: 
					@{int tot = level1 + level2 + level3 + level4 + level5;	}@tot.ToString()</b><br />&nbsp;</td>
			</tr>
		</table>

		level1 = 0;
		level2 = 0;
		level3 = 0;
		level4 = 0;
		level5 = 0;
	}

</div>

