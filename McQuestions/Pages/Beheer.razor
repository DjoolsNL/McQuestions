@if (xmlQuestions != null && ReadyForBrowser)
{
	<span>&nbsp:</span>
	<hr />
	foreach (var q in xmlQuestions)
	{
		string guid = q.Element("guid").Value;
		<div class="indexdiv">
			<button id="" @onclick="() => OnSave(fileName)">Save</button>&nbsp;

			@if (q.Element("disabled").Value == "true")
			{
				<button id="" @onclick="() => OnDisable(guid)">Enable</button>
				<span>&nbsp;</span>
			}
			else
			{
				<button id="" @onclick="() => OnDisable(guid)">Disable</button>
				<span>&nbsp;</span>
			}
			
			<button id="" @onclick="() => OnDelete(guid)">Delete</button>
		</div>
		<div class="indexdiv">
			<table>
				<tr>
					<td>Disabled&nbsp;</td>
					<td><input @bind="@q.Element("disabled").Value" /></td>
				</tr>
				<tr>
					<td>Guid&nbsp;</td>
					<td><input @bind="@q.Element("guid").Value" /></td>
				</tr>
				<tr>
					<td>Volgnummer</td>
					<td>@*<input @bind="@q.Element("volgnummer").Value" />*@</td>
				</tr>
				<tr>
					<td>Niveau</td>
					<td><input @bind="@q.Element("niveau").Value" /></td>
				</tr>

				<tr>
					<td>Onderwerp</td>
					<td><input @bind="@q.Element("onderwerp").Value" /></td>
				</tr>

				@foreach (var item in q.Element("header").Elements())
				{
					<tr>
						<td>Vraag</td>
						@if (item.Value.ToString().Length > 40)
						{
							int w = item.Value.ToString().Length * 10;
							int cols = 80;
							int rows = item.Value.ToString().Length / 60;
							<td>
								<textarea wrap="hard" cols="@(cols)" rows="@rows" @bind="@item.Value" />
							</td>
						}
						else
						{
							<td><input @bind="@item.Value" /></td>
						}
					</tr>
				}
				@{int teller = 1;}
				@foreach (var item in q.Element("keuzes").Elements())
				{
					<tr>
						<td>&nbsp;&nbsp;Optie</td>
						@if (item.Value.ToString().Length > 40)
						{
							int w = item.Value.ToString().Length * 10;
							int cols = 80;
							int rows = item.Value.ToString().Length / 60;
							<td>
								<textarea wrap="hard" cols="@(cols)" rows="@rows" @bind="@item.Value" />
							</td>
						}
						else
						{
							<td><input @bind="@item.Value" /></td>
						}
						
					</tr>
				}
				<tr>
					<td>Antwoord</td>
					<td><input @bind="@q.Element("antwoord").Value" /></td>
				</tr>

				<tr>
					<td>Userantwoord&nbsp</td>
					<td>
						@*<input @bind="@q.Element("userantwoord").Value" />*@
					</td>
				</tr>

				<tr>
					<td>Show</td>
					<td><input @bind="@q.Element("show").Value" /></td>
				</tr>

				<tr>
					<td>Uitleg</td>
					@if (q.Element("uitleg").Value.ToString().Length > 40)
					{
						int cols = 80;
						int rows = q.Element("uitleg").Value.ToString().Length/60;

						<td>
							<textarea wrap="hard" cols="@(cols)" rows="@rows" @bind="@q.Element("uitleg").Value" />
						</td>
					}
					else
					{
						<td><input @bind="@q.Element("uitleg").Value" /></td>
					}
				</tr>
			</table>
			<hr>
		</div>
	}
}

@code{
    public class Vraag
    {
        public Vraag()
        {
			Header = new();
			Keuzes = new();
        }

        public string guid { get; set; }
		public string volgnummer { get; set; }
        public string niveau { get; set; }
        public string onderwerp { get; set; }

		public List<string> Header;
		public List<string> Keuzes;

		public string antwoord { get; set; }
		public string show { get; set; }
		public string uitleg { get; set; }
    }
}





