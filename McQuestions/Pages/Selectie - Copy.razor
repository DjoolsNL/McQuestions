@page "/selectie/{fileName}"
@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO

@code
{
	[Parameter]
	public string FileName { get; set; }
	string pageTitle;
	string niveau;
	string naamVragenSet;
	string selectedOption;
	int count = 0;
	int randomNumber;
	public List<XElement> XmlQuestionsSelection = new();
	List<XElement> xmlQuestions = new();
	XElement root;
	bool ready;
	bool firstRun = true;
	bool radiobuttonLevel;	

	protected override void OnInitialized()
	{

	}

	private void OnChangeLevel(ChangeEventArgs e)
	{
		selectedOption = e.Value.ToString();
		StateHasChanged();
		XmlQuestionsSelection.Clear();
		niveau = e.Value.ToString();

		var allEnabledQuestions = root.Elements("vraag").Distinct().Where(e => e.Element("disabled").Value != "true").ToList();

		xmlQuestions = allEnabledQuestions.FindAll(l => l.Element("niveau").Value == niveau);
		count = xmlQuestions.Count();
	}

	private void OnChangeNumberOfQuestions(ChangeEventArgs e)
	{
		int choice;
		if (int.TryParse(e.Value.ToString(), out choice)){}

		for (int i = 0; i < choice; i++)
		{
			randomNumber = RandomHelper.Next(0, xmlQuestions.Count());
			xmlQuestions[randomNumber].Element("volgnummer").Value = i.ToString();
			XmlQuestionsSelection.Add(xmlQuestions[randomNumber]);
			xmlQuestions.RemoveAt(randomNumber);
		}
		ready = true;
	}

	private bool IsOptionSelected(string optionValue)
	{
		return selectedOption == optionValue;
	}
}

@if (FileName.StartsWith('{'))
{
	if (!firstRun)
	{
		selectedOption = null;
		StateHasChanged();
	}

	firstRun = false;
	xmlQuestions.Clear();
	XmlQuestionsSelection.Clear();
	FileName = FileName.Replace("{", "").Replace("}", "");
	Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory);
	string fullpath = Path.Combine(Directory.GetCurrentDirectory() + "\\XmlQuestions\\", FileName);
	var xmlString = File.ReadAllText(fullpath);
	root = XElement.Parse(xmlString);
	naamVragenSet = root.Element("vragenset").Value;
	
	string pageTitle = FileName.Replace(".xml", "");			
}

<PageTitle>@pageTitle</PageTitle>
<Style />


<span>
	&nbsp;&nbsp; Niveau:
	<label>
		<input type="radio" id="1" name="level" value="1" @onchange="OnChangeLevel" checked="@IsOptionSelected("1")" /> 1
	</label>
	<label>
		<input type="radio" id="2" name="level" value="2" @onchange="OnChangeLevel" checked="@IsOptionSelected("2")" /> 2
	</label>
	<label>
		<input type="radio" id="3" name="level" value="3" @onchange="OnChangeLevel" checked="@IsOptionSelected("3")" /> 3
	</label>
	<label>
		<input type="radio" id="4" name="level" value="4" @onchange="OnChangeLevel" checked="@IsOptionSelected("4")" /> 4
	</label>
	<label>
		<input type="radio" id="5" name="level" value="5" @onchange="OnChangeLevel" checked="@IsOptionSelected("5")" /> 5
	</label>
</span>

<span>
	&nbsp;&nbsp; Niveau Mix:
	<label>
		<input type="radio" name="level" value="6" @onchange="OnChangeLevel" /> 1-5
	</label>
	&nbsp;- &nbsp;Aantal vragen:
</span>

@if (count >= 50)
{
	<span>
		<label>
			<input type="radio" name="total" value="5" @onchange="OnChangeNumberOfQuestions" /> 5
		</label>
		<label>
			<input type="radio" name="total" value="10" @onchange="OnChangeNumberOfQuestions" /> 10
		</label>
		<label>
			<input type="radio" name="total" value="25" @onchange="OnChangeNumberOfQuestions" /> 25
		</label>
		<label>
			<input type="radio" name="total" value="25" @onchange="OnChangeNumberOfQuestions" /> 50
		</label>
	</span>
	count = 0;
}

@if (count < 50 && count >= 25)
{
	<span>	
		<label>
			<input type="radio" name="total" value="5" @onchange="OnChangeNumberOfQuestions" /> 5
		</label>
		<label>
			<input type="radio" name="total" value="10" @onchange="OnChangeNumberOfQuestions" /> 10
		</label>
		<label>
			<input type="radio" name="total" value="25" @onchange="OnChangeNumberOfQuestions" /> 25
		</label>
		<label>
			<input type="radio" name="total" value="45" @onchange="OnChangeNumberOfQuestions" /> 45
		</label>
	</span>
	count = 0;
}

@if (count < 25 && count >= 10)
{
	<span>
		<label>
			<input type="radio" name="total" value="5" @onchange="OnChangeNumberOfQuestions" /> 5
		</label>
		<label>
			<input type="radio" name="total" value="10" @onchange="OnChangeNumberOfQuestions" /> 10
		</label>
	</span>
	count = 0;
}

@if (count < 10 && count >= 5)
{
	<span>
		<label>
			<input type="radio" name="total" value="5" @onchange="OnChangeNumberOfQuestions" /> 5
		</label>
	</span>
	count = 0;
}

@if (count < 5 && count > 0)
{
	int tel = count;
	<span>
		<label>
			<input type="radio" name="total" value="@count" @onchange="OnChangeNumberOfQuestions" /> @count
		</label>
	</span>
	count = 0;
}

<hr />

@if (ready)
{
	<div class="indexdiv">
		<CascadingValue Value="XmlQuestionsSelection">
			<Uitvoering naamVragenSet="@naamVragenSet" levelQuestions="@niveau" />
		</CascadingValue>
	</div>
}








