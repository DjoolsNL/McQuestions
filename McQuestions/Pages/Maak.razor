@page "/maak"
@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO
@using System.Xml
@using System.Text;
<PageTitle>Maak</PageTitle>

<Style />

<style>
    .choice {
        background-color: #4CAF50;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .submit {
        width: 50%;
        height: 10%;
        background-color: lightgray;
        color: black;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    h2 {
        padding: 10px 20px;
        padding-left: 0px;
    }

    .flexible-textarea {
        width: 100%;
        height: 35px;
        /* min-width: 8rem; */
        resize: both;  /* Allow vertical and horizontal resizing of the textarea */
    }
</style>

<h2>Nieuwe vraag</h2>
<hr />
<div class="indexdiv">

    Toevoegen aan 
    <select @onchange="SelecteerFile">
        @foreach (var option in optionList)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
    <br />&nbsp;<br />&nbsp;

    <table width="80%" name="formcreatequestion">
        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Disabled:</label></td>
            <td><input type="text" @bind="disabled" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Vraag:</label></td>
            <td><textarea class="flexible-textarea" @bind="regel" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Eventuele Code:</label></td>
            <td><textarea class="flexible-textarea" @bind="regelCode" /></td>
        </tr>
        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Antwoord A:</label></td>
            <td><textarea class="flexible-textarea" type="text" @bind="choiceA" placeholder="Keuze A" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Antwoord B:</label></td>
            <td><textarea class="flexible-textarea" type="text" @bind="choiceB" placeholder="Keuze B" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Antwoord C:</label></td>
            <td><textarea class="flexible-textarea" type="text" @bind="choiceC" placeholder="Keuze C" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Antwoord D:</label></td>
            <td><textarea class="flexible-textarea" type="text" @bind="choiceD" placeholder="Keuze D" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Juiste Antwoord:</label></td>
            <td><input type="text" @bind="antwoord" /></td>
        </tr>


        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Niveau:</label></td>
            <td><input type="text" @bind="niveau" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Onderwerp:</label></td>
            <td><textarea class="flexible-textarea" type="text" @bind="onderwerp" /></td>
        </tr>

        <tr>
            <td><label>&nbsp;&nbsp;&nbsp;&nbsp;Uitleg:</label></td>

            <td><textarea class="flexible-textarea" wrap="hard" @bind="uitleg" /></td>
        </tr>
        <tr>
            <td><br /><button @onclick="Toevoegen">Toevoegen</button></td>

            <td></td>
        </tr>
    </table>

    
</div>

    @code 
{
    string folderPath;
    string[] fileNames;
    private string disabled;
    private string volgnummer;
    private string niveau;
    private string onderwerp;
    private string regel;
    private string regelCode;
    private string choiceA;
    private string choiceB;
    private string choiceC;
    private string choiceD;
    private string antwoord;
    private string userantwoord;
    private string show;
    private string uitleg;
    private List<Option> optionList = new List<Option>();
    private string selectedOption;



    protected override void OnInitialized()
    {
        Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory + "XmlQuestions\\");
        folderPath = Directory.GetCurrentDirectory();
        fileNames = Directory.GetFiles(folderPath);



        foreach (var filename in fileNames)
        {
            optionList.Add(new Option(Path.GetFileName(filename), Path.GetFileName(filename)));
        }
    }

    private void SelecteerFile(ChangeEventArgs e)
    {
        selectedOption = e.Value.ToString();
    }

    private async Task Toevoegen()
    {
        XElement newAddition = new XElement(
        new XElement("vraag",
            new XElement("disabled", disabled),
            new XElement("guid", Guid.NewGuid()),
            new XElement("volgnummer", volgnummer),
            new XElement("niveau", niveau),
            new XElement("onderwerp", onderwerp),
            new XElement("header",
                new XElement("regel", regel),
                new XElement("regel", regelCode)
                ),
            new XElement("keuzes",
                new XElement("A", choiceA),
                new XElement("B", choiceB),
                new XElement("C", choiceC),
                new XElement("D", choiceD)
                ),
            new XElement("antwoord", antwoord),
            new XElement("userantwoord", userantwoord),
            new XElement("show", show),
            new XElement("uitleg", uitleg)
        )
        );

        // string xmlString = newAddition.ToString();
        // byte[] xmlBytes = Encoding.UTF8.GetBytes(xmlString);

        XElement doc = XElement.Load(folderPath + "\\" + selectedOption);
        doc.Add(newAddition);
        doc.Save(folderPath + "\\" + selectedOption);


        selectedOption = "";

    }

        private class Option
        {
            public Option(string value, string label)
            {
                Value = value;
                Label = label;
            }

            public string Value { get; }
            public string Label { get; }
        }
    }
