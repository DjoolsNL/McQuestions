<svg width="400" height="300">
    <!-- X-axis -->
    <line x1="50" y1="250" x2="350" y2="250" style="stroke: black; stroke-width: 2;" />

    <!-- Y-axis -->
    <line x1="50" y1="50" x2="50" y2="250" style="stroke: black; stroke-width: 2;" />

    <!-- Data points -->
    <polyline points="@GetPolylinePoints()" style="fill: none; stroke: blue; stroke-width: 2;" />
</svg>

@code {
    private List<DataPoint> dataPoints = new List<DataPoint>
    {
        new DataPoint { X = 0, Y = 100 },
        new DataPoint { X = 1, Y = 80 },
        new DataPoint { X = 2, Y = 120 },
        new DataPoint { X = 3, Y = 70 },
        // Add more data points as needed
    };

    private string GetPolylinePoints()
    {
        var points = new List<string>();
        int xOffset = 50;
        int yOffset = 250;
        int xInterval = 150;
        int yScale = 2;

        for (int i = 0; i < dataPoints.Count; i++)
        {
            var x = xOffset + i * xInterval;
            var y = yOffset - dataPoints[i].Y * yScale;
            points.Add($"{x},{y}");
        }

        return string.Join(" ", points);
    }

    private class DataPoint
    {
        public int X { get; set; }
        public int Y { get; set; }
    }
}


