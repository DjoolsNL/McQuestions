@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO

@code
{
	[CascadingParameter] public List<XElement>? XmlQuestionsSelection { get; set; }
	List<XElement> LocalxmlQuestionsSelection;

	[Parameter]	public string NaamVragenSet { get; set; }
	[Parameter] public string LevelQuestions { get; set; }

	public int score = 0;

	public string folderPath;
	string pathToFile;
	private List<XElement> testUitslagen;

	public double fraction;
	public double percentage;
	public string result; 
	public int sumofquestions;
	public int sumofscore;

	DateTime currentDate  = DateTime.Today;

	public string textButtonStandAlone = "Stand-alone AI";
	public string textButtonIntegrated = "Integrated AI";

	private bool IsStandAloneVisible = false;
	private bool IsIntegratedVisible = false;
	private bool IsPrompt1Visible = false;


	private string ClickedStandAlone = null;
	private string ClickedIntegrated = null;
	private string ClickedPrompt1 = null;

	protected override void OnInitialized()
	{

		@if (XmlQuestionsSelection.Count() != 0)
		{
			LocalxmlQuestionsSelection = XmlQuestionsSelection;

			XElement onderwerpen = new XElement("onderwerpen");
			foreach (var question in XmlQuestionsSelection)
			{
				if (question.Element("antwoord").Value == question.Element("userantwoord").Value)
				{ score++; }
				else
				{
					XElement onderwerp = new XElement("onderwerp", question.Element("onderwerp").Value);
					onderwerpen.Add(onderwerp);
				}
			}

			Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory + "XmlAccount\\");
			folderPath = Directory.GetCurrentDirectory();
			pathToFile = folderPath + "\\AccountResults.xml";

			var xmlString = File.ReadAllText(pathToFile);
			var rootElement = XElement.Parse(xmlString);
			
			XElement doc = new XElement("root");
			testUitslagen = rootElement.Elements("test").ToList();		
			XElement test = new XElement("test");
			XElement datum = new XElement("datum", currentDate.ToString("d-M-yyyy"));
			XElement vragenset = new XElement("vragenset", NaamVragenSet);
			XElement niveau = new XElement("niveau", LevelQuestions);
			XElement aantal = new XElement("aantal", XmlQuestionsSelection.Count().ToString());
			XElement scoore = new XElement("score", score);

			//question.Element("antwoord").Value == question.Element("userantwoord").Value

			test.Add(datum, vragenset, niveau, aantal, scoore, onderwerpen);
			testUitslagen.Add(test);

			foreach (var testt in testUitslagen)
			{
				XElement testtt = new XElement("test", testt.Elements());
				doc.Add(testtt);
			}

			doc.Save(pathToFile);

			if (LevelQuestions != "6")
			{
				// nu nog de gegevens uit xmlTests halen en weergeven 
				var selectie = testUitslagen.FindAll(t => t.Element("vragenset").Value == NaamVragenSet && t.Element("niveau").Value == LevelQuestions);
				sumofquestions = selectie.Sum(e => (int)e.Element("aantal"));
		 
				sumofscore = selectie.Sum(e => (int)e.Element("score"));
			}
		}
	}

	private void ShowStandAlone(string volgnummer)
	{
		if (ClickedStandAlone == volgnummer)
		{
			ClickedStandAlone = null;
		}
		else
		{
			ClickedStandAlone = volgnummer;
		}
	}

	private void ShowIntegrated(string volgnummer)
	{
		if (ClickedIntegrated == volgnummer)
		{
			ClickedIntegrated = null;
		}
		else
		{
			ClickedIntegrated = volgnummer;
		}
	}

	private void ShowPrompt1(string volgnummer)
	{
		if (ClickedIntegrated == volgnummer)
		{
			ClickedIntegrated = null;
		}
		else
		{
			ClickedIntegrated = volgnummer;
		}
	}
	
}

@if (XmlQuestionsSelection.Count() != 0)
{
	fraction = (double)score / (double)XmlQuestionsSelection.Count();
	percentage = fraction * 100;
	result = $"{percentage:0.00}%";

	if (LevelQuestions != "6")
	{
		<p><b>Score: @result</b> (@score / @XmlQuestionsSelection.Count) &nbsp;&nbsp;/&nbsp;&nbsp; foute antwoorden zijn in <span style="color:red">rood</span> weergegeven.</p>
		fraction = (double)sumofscore / (double)sumofquestions;
		percentage = fraction * 100;
		result = $"{percentage:0.00}%";
		<p><b>Total score @NaamVragenSet niveau @LevelQuestions: @result</b> (@sumofscore.ToString() / @sumofquestions.ToString())</p>

		<hr />
		<h2>Antwoorden</h2>
		<hr />
	}
}

<!--   TESTUITSLAG VRAGEN EN ANTWOORDEN  -->
@if (XmlQuestionsSelection.Count() != 0)
{
	foreach (var question in XmlQuestionsSelection)
	{
		var letterJuisteAntwoord = question.Element("antwoord").Value;
		var letterGebruikersAntwoord = question.Element("userantwoord").Value;
		var juisteAntwoord = question.Element("keuzes").Element(letterJuisteAntwoord).Value;
		// niet gebruikt:
		var fouteAntwoord = question.Element("keuzes").Element(letterGebruikersAntwoord).Value;

		string volgnummer = question.Element("volgnummer").Value;
		IsStandAloneVisible = ClickedStandAlone == volgnummer;
		IsIntegratedVisible = ClickedIntegrated == volgnummer;
		IsPrompt1Visible = ClickedPrompt1 == volgnummer;

		<div>
			<p>@question.Element("header").Value</p>
			<p class="inspringen">
				<span class="blauw">
					<span class="oi oi-circle-check"></span> Het juiste antwoord: @juisteAntwoord
				</span>
			</p>

			@if (letterGebruikersAntwoord != null && letterGebruikersAntwoord != letterJuisteAntwoord)
			{
				<p class="inspringen">
					<span style="color:red">
						<span class="oi oi-circle-x"></span>&nbsp;Jouw antwoord was fout
					</span>
				</p>
			}

			<table style="display:inline; margin-left:25px; margin-top:30px">
				<tr>
					<td>
                        <button @onclick="() => ShowStandAlone(volgnummer)" class="choice">@textButtonStandAlone</button><span>&nbsp;&nbsp;</span>
					</td>
					<td>
@* 						<button @onclick="() => ShowIntegrated(volgnummer)" class="choice">@textButtonIntegrated</button><span>&nbsp;&nbsp;</span> *@
					</td>
				</tr>
			</table>

		<!-- PROMPTS   PROMPTS -->
			@if (IsStandAloneVisible)
			{
				<div>
					<p><b>Copy the instructions and the question below and post them to your AI teacher.</b>
						<br /><br />
						<b>Instructions</b>
						<br />
						I'm learning to code <span style="color:red">@NaamVragenSet</span>. Here is a multiple choice question about <span style="color:red">@NaamVragenSet</span>. On a scale from 1 to 5 (where 1 is beginner and 5 is senior) <span style="color:red">my level is @question.Element("niveau").Value</span>. Please consider my level when answering the question.
						<br />
						Tell me the correct answer and explain why it's correct.
						<br />
						Explain why the topic <span style="color:red">@question.Element("onderwerp").Value</span> is important in <span style="color:red">@NaamVragenSet</span>.
						If possible provide a simple code example and explain the code.<br />
						Give me a real-world scenario where such code could be useful.<br />
						<b>Question</b><br />
						@foreach (var regel in question.Element("header").Elements())
						{
							@regel.Value<br />
						}
						@foreach (XElement choice in question.Element("keuzes").Elements())
						{
							<span>@choice.Name.LocalName	&nbsp;@choice.Value</span> <br />
						}

						<br /><b>Possible prompts for further study</b><br />
						<span><b>Instruction</b></span><br />
						<span>Summarize your answer</span><br /><br />
						<span><b>Instruction</b></span><br />
						<span>Translate your answer in Dutch for a level @question.Element("niveau").Value student and explain like I'm 16 year old.</span>
						<br /><br />
						<span><b>Instruction</b></span><br />
						Can you ask me another multiple choice question about <span style="color:red">@NaamVragenSet @question.Element("onderwerp").Value</span>
					</p>
				</div>
			}

			@if (IsIntegratedVisible)
			{
				// hier dus de hele dialoog met AI inbouwen
				<div>
					AI:<br />
					@question.Element("uitleg").Value
				</div>
				@* <button @onclick="() => ShowPrompt1(volgnummer)" class="choice">Vertaal in het Nederlands</button> *@

				<span>&nbsp;&nbsp;</span>
				// drie knoppen met prompt suggesties voor vervolgvragen
				// per gebruikte suggestie antwoord ophalen en weergeven.
			}

			@if (IsPrompt1Visible)
			{
				<div>
					AI:<br />
					@question.Element("prompt1").Value
				</div>
			}
			<hr />
		</div>
	}
}




