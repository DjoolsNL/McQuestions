@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO
@code {
	[Parameter]
	public string pathXmlFile { get; set; }
	[Parameter]
	public int totalQuestions { get; set; }
	[Parameter]
	public int levelQuestions { get; set; }

	private List<XElement> xmlQuestions;
	private int currentQuestionIndex = 0;
	private int score = 0;
	private string answer = "";
	private string submitButtonText = "Maak een keuze";
	private string naamVragenSet;

	private int randomNumber;

	private string McDevelopment()
	{
		var url = $"/mcdevelopment";
		return url;
	}

	protected override void OnInitialized()
	{
		Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory);
		string fullpath = Path.Combine(Directory.GetCurrentDirectory(), pathXmlFile);
		var xmlString = File.ReadAllText(fullpath);
		var rootElement = XElement.Parse(xmlString);

		naamVragenSet = rootElement.Element("vragenset").Value;
		// selecteer alleen vragen die niet disabled zijn:
		xmlQuestions = rootElement.Elements("vraag").Distinct().Where(e => e.Element("disabled").Value != "true").ToList();

		int volgnummer = 1;
		foreach (var question in xmlQuestions)
		{
			question.Element("volgnummer").Value = volgnummer.ToString();
			volgnummer++;
		}

		// als user voor beperkt aantal vragen heeft gekozen 
		if (totalQuestions != 0 && levelQuestions != 0)
		{
			if (levelQuestions == 6)
			{
				var ssss = xmlQuestions.ToList();
				xmlQuestions.Clear();

				for (int i = 0; i < totalQuestions; i++)
				{
					randomNumber = RandomHelper.Next(0, ssss.Count());
					xmlQuestions.Add(ssss[randomNumber]);
					ssss.RemoveAt(randomNumber);
				}
			}
			else
			{
				var ssss  = xmlQuestions.FindAll(l => l.Element("niveau").Value == levelQuestions.ToString());
				xmlQuestions.Clear();

				if (ssss.Count() < totalQuestions)
				{
					totalQuestions = ssss.Count();
					for (int i = 0; i < totalQuestions; i++)
					{
						randomNumber = RandomHelper.Next(0, ssss.Count());
						xmlQuestions.Add(ssss[randomNumber]);
						ssss.RemoveAt(randomNumber);
					}
				}
				else
				{
					for (int i = 0; i < totalQuestions; i++)
					{
						randomNumber = RandomHelper.Next(0, ssss.Count());
						xmlQuestions.Add(ssss[randomNumber]);
						ssss.RemoveAt(randomNumber);
					}
				}

			}
		}
	}

	private void HandleAnswerSelection(string choice)
	{
		answer = choice;
		submitButtonText = "Antwoord met: " + answer;
	}

	private void Submit(XElement xElementQuestion)
	{
		if (answer == "")
		{
			submitButtonText = "Maak een keuze";
		}
		else
		{
			// userantwoord wordt in de vraag gezet die naar AI gaat
			xElementQuestion.Element("userantwoord").Value = answer;

			submitButtonText = "Maak een keuze";
			answer = "";

			if (currentQuestionIndex < xmlQuestions.Count)
			{
				currentQuestionIndex++;
			}
		}
	}

	private void Exit(int number)
	{
		int c = xmlQuestions.Count();
		xmlQuestions.RemoveRange(number, c-number);
	}
}

<h2>@naamVragenSet Vragenset</h2>
<hr />

<!--Creates a question	-->
@if (xmlQuestions != null && currentQuestionIndex < xmlQuestions.Count)
{
	var currentQuestion = xmlQuestions[currentQuestionIndex];
	int teller = 0;

	<p>@(currentQuestionIndex + 1)/@xmlQuestions.Count</p>
	<div>
		@foreach (var regel in currentQuestion.Element("header").Elements())
		{
			if (teller == 0)
			{
				<h4>@regel.Value</h4>
			}
			else
			{
				@regel.Value<br />
			}
			teller++;
		}
	</div>

	<div>
		<br />
		<table>
		@foreach (var choice in currentQuestion.Element("keuzes").Elements())
		{
			<tr>
				<td>@choice.Name&nbsp;&nbsp;</td>
				<td><button @onclick="() => HandleAnswerSelection(choice.Name.LocalName)" class="choice">
							@choice.Value
						</button>
				</td>
			</tr>
		}
			<tr>
				<td colspan="2">
				</td>
			</tr>
			<tr>
				<td></td>
				<td>
					<br />
					<button @onclick="(args) => Submit(currentQuestion)" class="submit">@submitButtonText</button>
				</td>
			</tr>
		</table>
	</div>
	<hr />
	// tussentijds de vragenlijst afbreken met de exit knop
	<p><button @onclick="(args) => Exit(currentQuestionIndex)" class="submit">Exit</button></p>
}

else if (currentQuestionIndex == xmlQuestions.Count)
{
@*	<h2>@nameVragenSet</h2>
	<hr />*@
	<CascadingValue Value="xmlQuestions">
		<Testuitslag naamvragenset="@naamVragenSet"  />	
	</CascadingValue>


@*	@inject NavigationManager NavigationManager
	<h6><a href="@McDevelopment()">Naar McDev</a></h6>*@
}


