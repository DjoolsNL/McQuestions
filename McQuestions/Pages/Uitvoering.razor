@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO

@code {
	[Parameter]
	public string pathXmlFile { get; set; }
	[Parameter]
	public int totalQuestions { get; set; }
	[Parameter]
	public string levelQuestions { get; set; }
	[Parameter]
	public string naamVragenSet { get; set; }

	[CascadingParameter]
	public List<XElement>? xmlQuestionsSelection { get; set; }

	private List<XElement> xmlQuestions;
	private int currentQuestionIndex = 0;
	private int score = 0;
	private string answer = "";
	private string submitButtonText = "Maak een keuze";

	private int randomNumber;

	private string McDevelopment()
	{
		var url = $"/mcdevelopment";
		return url;
	}

	protected override void OnInitialized()
	{

	}

	private void HandleAnswerSelection(string choice)
	{
		answer = choice;
		submitButtonText = "Antwoord met: " + answer;
	}

	private void Submit(XElement xElementQuestion)
	{
		if (answer == "")
		{
			submitButtonText = "Maak een keuze";
		}
		else
		{
			// userantwoord wordt in de vraag gezet die naar AI gaat
			xElementQuestion.Element("userantwoord").Value = answer;

			submitButtonText = "Maak een keuze";
			answer = "";

			if (currentQuestionIndex < xmlQuestionsSelection.Count)
			{
				currentQuestionIndex++;
			}
		}
	}

	private void Exit(int number)
	{
		int c = xmlQuestionsSelection.Count();
		xmlQuestionsSelection.RemoveRange(number, c - number);
	}
}

<h2>@naamVragenSet Vragenset</h2>
<hr />

<!--Creates a question	-->
@if (xmlQuestionsSelection != null && currentQuestionIndex < xmlQuestionsSelection.Count)
{
	var currentQuestion = xmlQuestionsSelection[currentQuestionIndex];
	int teller = 0;

	<p>@(currentQuestionIndex + 1)/@xmlQuestionsSelection.Count</p>
	<div>
		@foreach (var regel in currentQuestion.Element("header").Elements())
		{
			if (teller == 0)
			{
				<h4>@regel.Value</h4>
			}
			else
			{
				@regel.Value<br />
			}
			teller++;
		}
	</div>

	<div>
		<br />
		<table>
		@foreach (var choice in currentQuestion.Element("keuzes").Elements())
		{
			<tr>
				<td>@choice.Name&nbsp;&nbsp;</td>
				<td><button @onclick="() => HandleAnswerSelection(choice.Name.LocalName)" class="choice">
							@choice.Value
						</button>
				</td>
			</tr>
		}
			<tr>
				<td colspan="2">
				</td>
			</tr>
			<tr>
				<td></td>
				<td>
					<br />
					<button @onclick="(args) => Submit(currentQuestion)" class="submit">@submitButtonText</button>
				</td>
			</tr>
		</table>
	</div>
	<hr />
	// tussentijds de vragenlijst afbreken met de exit knop
	<p><button @onclick="(args) => Exit(currentQuestionIndex)" class="submit">Exit</button></p>
}

else if (currentQuestionIndex == xmlQuestionsSelection.Count)
{
	currentQuestionIndex = 0;
	@*	<h2>@nameVragenSet</h2>
	<hr />*@
	<CascadingValue Value="xmlQuestionsSelection">
		<Verwerking naamVragenSet="@naamVragenSet" levelQuestions="@levelQuestions.ToString()" />
	</CascadingValue>


@*	@inject NavigationManager NavigationManager
	<h6><a href="@McDevelopment()">Naar McDev</a></h6>*@
}


