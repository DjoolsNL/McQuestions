@using System.IO
@using System.Xml;
<PageTitle>Profile</PageTitle>
<Style />

@code 
{
	private string name;
	string folderPath;
	string pathToaccountResults;
	string pathToAccountResultsNietKennisTests;
	private List<XElement> xmlTests;
	private List<XElement> xmlTestsNietKennisTests;
	private List<string> distinctSetNames;
	private List<string> distinctSetNamesNietKennisTests;
	private bool accountResultsIsEmpty = true;
	private bool accountResultsNietKennisTestsIsEmpty = true;
	private bool IsStudyAdviceVisible = false;
	private string ClickedStudyAdvice = null;

	protected override void OnInitialized()
	{		
		Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory + "XmlAccount\\");
		folderPath = Directory.GetCurrentDirectory();

		pathToaccountResults = folderPath + "\\AccountResults.xml";
		pathToAccountResultsNietKennisTests = folderPath + "\\AccountResultsNietKennisTests.xml";

		Tests(pathToaccountResults);
		TestsNietKennis(pathToAccountResultsNietKennisTests);
	}

	void Tests(string path)
	{
		var xmlString = File.ReadAllText(pathToaccountResults);
		var rootElement = XElement.Parse(xmlString);
		xmlTests = rootElement.Elements("test").ToList();

		distinctSetNames = xmlTests.Select(element => element.Element("vragenset").Value).Distinct().ToList();
		accountResultsIsEmpty = false;
	}

	void TestsNietKennis(string path)
	{
		var xmlStringNietKennis = File.ReadAllText(pathToAccountResultsNietKennisTests);
		var rootElementNietKennis = XElement.Parse(xmlStringNietKennis);
		xmlTestsNietKennisTests = rootElementNietKennis.Elements("test").ToList();

		distinctSetNamesNietKennisTests = xmlTestsNietKennisTests.Select(element => element.Element("vragenset").Value).Distinct().ToList();
		accountResultsNietKennisTestsIsEmpty = false;		
	}

	private void ShowStudyAdvice(string identifier)
	{
		if(ClickedStudyAdvice == identifier)
		{
			ClickedStudyAdvice = null;
		}
		else
		{
			ClickedStudyAdvice = identifier;
		}
	}


}
<h2 style="display: inline">Jules van Nuijs</h2> Sss LKQ | Startdatum: 1 juli 2023 | Einddatum: 31 december 2023 | Dagen te gaan: 125
<hr />

<div class="indexdiv">
	@foreach (var distinct in distinctSetNames)
	{
		var distinctSet = xmlTests.FindAll(t => t.Element("vragenset").Value == distinct); // bijv. alle tests JavaScript

		var distinctNiveaus = distinctSet.Select(element => element.Element("niveau").Value).Distinct().ToList();

		foreach (var distinctNiveau in distinctNiveaus)
		{
			var distinctNivo = distinctSet.FindAll(t => t.Element("niveau").Value == distinctNiveau); // bijv. alle tests JavaScript niveau 1 
			
			int aantaltests = distinctNivo.Count();
			List<(string date, string score, string totalq)> tupleList = new List<(string, string, string)>() ;
			List<string> onderwerpen = new();
			int afstandx = 500 / aantaltests;
			string pair = "";
			for (int i = 0; i < aantaltests; i++)
			{
				int sc = Convert.ToInt32(distinctNivo[i].Element("score").Value);
				int antal = Convert.ToInt32(distinctNivo[i].Element("aantal").Value);

				int perc = 100 * sc/antal;
				int y = 210 - perc * 2;

				int x = 30 + i * afstandx;
				pair += $"{x},{y} ";
				tupleList.Add((distinctNivo[i].Element("datum").Value, distinctNivo[i].Element("score").Value, distinctNivo[i].Element("aantal").Value));

				var shshs = distinctNivo[i].Element("onderwerpen").Elements("onderwerp").ToList();
				foreach (var item in shshs)
				{
					onderwerpen.Add(item.Value);
				}

			}
			pair = pair.TrimEnd();

			var sumofquestions = distinctNivo.Sum(e => (int)e.Element("aantal"));
			var sumofscore = distinctNivo.Sum(e => (int)e.Element("score"));
			double fraction = (double)sumofscore / (double)sumofquestions;
			double percentage = fraction * 100;
			string result = $"{percentage:0.00}%";
			IsStudyAdviceVisible = ClickedStudyAdvice == distinct + distinctNiveau;
			if (distinctNiveau == "6")
			{
				<p><br /><b><span style="color:#4CAF50;">Gemiddelde test score</span> @distinct - Niveaumix: @result</b> (@sumofscore.ToString() / @sumofquestions.ToString())</p>	
			}
			else
			{
				<p>
					<br /><b><span style="color:#4CAF50;">Gemiddelde testscore</span> @distinct - niveau @distinctNiveau: @result</b> (@sumofscore.ToString() / @sumofquestions.ToString()) 
					<span><button @onclick="() => ShowStudyAdvice(distinct + distinctNiveau)" class="choice">Toon studie advies en lastige onderwerpen</button></span></p>
			}

			if (IsStudyAdviceVisible)
			{
				if (sumofquestions < 35)
				{
					<span>Hoe meer vragen je maakt hoe duidelijker je gemiddelde score laat zien waar je precies staat. Bij een gemiddelde van 80 bij 80 vragen ga je over naar niveau 2. Omdat je niet eens op de helft van het aantal vragen zit, moet je nog flink wat tests afleggen.<br />
					
					</span> 
				}
				<p><br /><b>lastige onderwerpen:</b>&nbsp;
				@foreach (var item in onderwerpen)
				{
					if (item != "")
					{
						<span>@item, </span>
					}
				}
				</p>
			}
			
			
			<svg viewBox="0 0 580 220" xmlns="http://www.w3.org/2000/svg">
				<!-- Rectangle background -->
				<rect x="30" y="10" width="500" height="200" stroke="black" stroke-width="1" fill="none" />

				<!-- formule: y: 200 - percentage x 2  formule x: 500 / aantal tests -->
				<!-- Horizontal lines -->
				<line x1="30" y1="30"  x2="530" y2="30"  />
				<line x1="30" y1="50"  x2="530" y2="50"  />
				<line x1="30" y1="70"  x2="530" y2="70"  />
				<line x1="30" y1="90"  x2="530" y2="90"  />
				<line x1="30" y1="110" x2="530" y2="110" />
				<line x1="30" y1="130" x2="530" y2="130" />
				<line x1="30" y1="150" x2="530" y2="150" />
				<line x1="30" y1="170" x2="530" y2="170" />
				<line x1="30" y1="190" x2="530" y2="190" />

				@{int yyy = 210 - (int)percentage * 2; }
				<line class="average" x1="25" y1="@yyy.ToString()" x2="530" y2="@yyy.ToString()" stroke="rgba(255, 0, 0, 0.5)" stroke-width="5" stroke-dasharray="6   4" />

				<text x="0"   y="15"  font-size="12" fill="black">100</text>
				<text x="3"   y="35"  font-size="12" fill="black">90</text>
				<text x="3"   y="55"  font-size="12" fill="black">80</text>
				<text x="3"   y="75"  font-size="12" fill="black">70</text>
				<text x="3"   y="95"  font-size="12" fill="black">60</text>
				<text x="3"   y="115" font-size="12" fill="black">50</text>
				<text x="3"   y="135" font-size="12" fill="black">40</text>
				<text x="3"   y="155" font-size="12" fill="black">30</text>
				<text x="3"   y="175" font-size="12" fill="black">20</text>
				<text x="3"   y="195" font-size="12" fill="black">10</text>

				<text x="536" y="15"  font-size="12" fill="black">100</text>
				<text x="538" y="35"  font-size="12" fill="black">90</text>
				<text x="538" y="55"  font-size="12" fill="black">80</text>
				<text x="538" y="75"  font-size="12" fill="black">70</text>
				<text x="538" y="95"  font-size="12" fill="black">60</text>
				<text x="538" y="115" font-size="12" fill="black">50</text>
				<text x="538" y="135" font-size="12" fill="black">40</text>
				<text x="538" y="155" font-size="12" fill="black">30</text>
				<text x="538" y="175" font-size="12" fill="black">20</text>
				<text x="538" y="195" font-size="12" fill="black">10</text>

				<polyline points="@pair" fill="none" stroke="black" />

				@{
					string[] ss = pair.Split(" ");
					int count = ss.Count();
					for (int i = 0; i < count; i++)
					{
						string[] sss = ss[i].Split(",");
						<circle cx="@sss[0]" cy="@sss[1]" r="5" fill="orange">
							<title>Test #@(i+1) - Testdatum: @tupleList[i].date - Testscore: @tupleList[i].score van @tupleList[i].totalq</title>
						</circle> 
					}
				}
			</svg>

			<hr />
		}
	}		

