@page "/javascript"

<PageTitle>Javascript</PageTitle>
<Style />

@code
{
	private int totalQ;
	private int levelQ;

	private void OnChangeTotal(ChangeEventArgs e)
	{
		int parsedTotalQ;
		if (int.TryParse(e.Value.ToString(), out parsedTotalQ))
			totalQ = parsedTotalQ;
	}

	private void OnChangeLevel(ChangeEventArgs e)
	{
		int parsedTotalQ;
		if (int.TryParse(e.Value.ToString(), out parsedTotalQ))
			levelQ = parsedTotalQ;
	}
}

<span>
	Aantal vragen:
	<label>
		<input type="radio" name="total" value="5" @onchange="OnChangeTotal" /> 5
	</label>
	<label>
		<input type="radio" name="total" value="10" @onchange="OnChangeTotal" /> 10
	</label>
	<label>
		<input type="radio" name="total" value="25" @onchange="OnChangeTotal" /> 25
	</label>
	<label>
		<input type="radio" name="total" value="50" @onchange="OnChangeTotal" /> 50
	</label>
</span>

<span>
	&nbsp;&nbsp; Niveau:
	<label>
		<input type="radio" name="level" value="1" @onchange="OnChangeLevel" /> 1
	</label>
	<label>
		<input type="radio" name="level" value="2" @onchange="OnChangeLevel" /> 2
	</label>
	<label>
		<input type="radio" name="level" value="3" @onchange="OnChangeLevel" /> 3
	</label>
	<label>
		<input type="radio" name="level" value="4" @onchange="OnChangeLevel" /> 4
	</label>
	<label>
		<input type="radio" name="level" value="5" @onchange="OnChangeLevel" /> 5
	</label>
</span>

<span>
	&nbsp;&nbsp; Niveau Mix:
	<label>
		<input type="radio" name="level" value="6" @onchange="OnChangeLevel" /> 1-5
	</label>
</span>
<hr />


<div class="indexdiv">

	@if (totalQ != 0 && levelQ != 0)
	{
		<GenerateTest pathXmlFile="XmlQuestions\\Javascript.xml" totalQuestions="@totalQ" levelQuestions="@levelQ" />
	}


</div>







