@page "/account"
@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO
<PageTitle>Profile</PageTitle>
<Style />
<style>
line{
    stroke:lightgray;
}
.average{
	stroke: #4CAF50;
}
</style>
@code 
{
	private string name;
	public string folderPath;
	string pathToFile;
	private List<XElement> xmlTests;
	private List<string> sets;

	protected override void OnInitialized()
	{
		Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory + "XmlAccount\\");
		folderPath = Directory.GetCurrentDirectory();
		pathToFile = folderPath + "\\AccountResults.xml";
		var xmlString = File.ReadAllText(pathToFile);
		var rootElement = XElement.Parse(xmlString);
		xmlTests = rootElement.Elements("test").ToList();

		sets = xmlTests.Select(element => element.Element("vragenset").Value).Distinct().ToList();
	}

	// per set een opsomming per niveau 
	// dus per niveau totaliseren totaal, tot goed en tot fout en percentage goed uitrekenen 
}


<style>
b{
	padding-bottom:1px;
}
</style>
<div class="indexdiv">
@foreach (var item in sets)
{
	var set = xmlTests.FindAll(t => t.Element("vragenset").Value == item);

	var niveaus = set.Select(element => element.Element("niveau").Value).Distinct().ToList();

	foreach (var niveau in niveaus)
	{
		var nivo = set.FindAll(t => t.Element("niveau").Value == niveau); // lijst per niveau 
		int aantaltests = nivo.Count();
		List<string> polyline = new();
		int afstandx = 500 / aantaltests;

		string pair = "";
		for (int i = 0; i < aantaltests; i++)
		{
			int sc = Convert.ToInt32(nivo[i].Element("score").Value);
			int antal = Convert.ToInt32(nivo[i].Element("aantal").Value);

			int perc = 100 * sc/antal;
			int y = 200 - perc * 2;

			int x = 30 + i * afstandx;
			pair += $"{x},{y} ";
				
		}
			pair = pair.TrimEnd();
			var sumofquestions = nivo.Sum(e => (int)e.Element("aantal"));
		var sumofscore = nivo.Sum(e => (int)e.Element("score"));
		double fraction = (double)sumofscore / (double)sumofquestions;
		double percentage = fraction * 100;
		string result = $"{percentage:0.00}%";
		<p><br /><b><span style="color:#4CAF50;">Average test score</span> @item - niveau @niveau: @result</b> (@sumofscore.ToString() / @sumofquestions.ToString())</p>


	<svg viewBox="0 0 580 210" xmlns="http://www.w3.org/2000/svg">
    <!-- Rectangle background -->
    <rect x="30" y="0" width="500" height="200" stroke="black" stroke-width="1" fill="none" />

    <!-- formule: y: 200 - percentage x 2  formule x: 500 / aantal tests -->
    <!-- Horizontal lines -->
    <line x1="30" y1="20"  x2="530" y2="20"  />
    <line x1="30" y1="40"  x2="530" y2="40"  />
    <line x1="30" y1="60"  x2="530" y2="60"  />
    <line x1="30" y1="80"  x2="530" y2="80"  />
    <line x1="30" y1="100" x2="530" y2="100" />
    <line x1="30" y1="120" x2="530" y2="120" />
    <line x1="30" y1="140" x2="530" y2="140" />
    <line x1="30" y1="160" x2="530" y2="160" />
    <line x1="30" y1="180" x2="530" y2="180" />

	@{int yyy = 200 - (int)percentage * 2; }
	<line class="average" x1="25" y1="@yyy.ToString()" x2="530" y2="@yyy.ToString()" stroke="rgba(255, 0, 0, 0.5)" stroke-width="5" stroke-dasharray="6   4" />

    <text x="534" y="10"  font-size="12" fill="black">100</text>
    <text x="536" y="30"  font-size="12" fill="black">90</text>
    <text x="536" y="50"  font-size="12" fill="black">80</text>
    <text x="536" y="70"  font-size="12" fill="black">70</text>
    <text x="536" y="90"  font-size="12" fill="black">60</text>
    <text x="536" y="110" font-size="12" fill="black">50</text>
    <text x="536" y="130" font-size="12" fill="black">40</text>
    <text x="536" y="150" font-size="12" fill="black">30</text>
    <text x="536" y="170" font-size="12" fill="black">20</text>
    <text x="536" y="190" font-size="12" fill="black">10</text>

    <text x="0"   y="10"  font-size="12" fill="black">100</text>
    <text x="3"   y="30"  font-size="12" fill="black">90</text>
    <text x="3"   y="50"  font-size="12" fill="black">80</text>
    <text x="3"   y="70"  font-size="12" fill="black">70</text>
    <text x="3"   y="90"  font-size="12" fill="black">60</text>
    <text x="3"   y="110" font-size="12" fill="black">50</text>
    <text x="3"   y="130" font-size="12" fill="black">40</text>
    <text x="3"   y="150" font-size="12" fill="black">30</text>
    <text x="3"   y="170" font-size="12" fill="black">20</text>
    <text x="3"   y="190" font-size="12" fill="black">10</text>

    <polyline points="@pair" fill="none" stroke="black" />

				@{
					string[] ss = pair.Split(" ");
					foreach (var itmem in ss)
					{
						string[] sss = itmem.Split(",");
						<circle cx="@sss[0]" cy="@sss[1]" r="5" fill="orange" />
					}

				}


</svg>
		<hr />
	}

}



