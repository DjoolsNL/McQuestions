@page "/selectie/{fileName}"
@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO

@code {
    [Parameter] public string FileName { get; set; }
    string paginaNaam;
    string niveau;
    string NaamVragenSet;
    string gekozenAantalTestvragen;
    string gekozenTestNiveau;
    int count = 0;
    int randomIndex;
    List<XElement> XmlQuestionsSelection = new();
    List<XElement> xmlQuestions = new();
    XElement root;
    bool NaarVerwerking { get; set; }
    bool ClearRadioButtons { get; set; }
    public string NiveauTestvragen { get; set; }
    private int currentQuestionIndex = 0;
    private int score = 0;
    private string answer = "";
    private string submitButtonText = "Maak een keuze";

    private bool LevelSelected(string optionValue)
    {
        return gekozenTestNiveau == optionValue;
    }
    private bool NumberOfQuestionsSelected(string optionValue)
    {
        return gekozenAantalTestvragen == optionValue;
    }

    private void KeuzeTestNiveau(ChangeEventArgs e)
    {
        gekozenTestNiveau = e.Value.ToString();
        StateHasChanged();
        XmlQuestionsSelection.Clear();
        niveau = e.Value.ToString();

        var allEnabledQuestions = root.Elements("vraag")
            .Distinct()
            .Where(e => e.Element("disabled").Value != "true")
            .ToList();

        if (gekozenTestNiveau == "6")
        {
            List<string> niveaus = allEnabledQuestions
                .Select(vraag => vraag.Element("niveau").Value)
                .Distinct()
                .ToList();

            List<int> totalsPerLevel = new List<int>();
            foreach (var niveau in niveaus)
            {
                var totalPerLevel = allEnabledQuestions.Count(vraag => vraag.Element("niveau").Value == niveau);
                totalsPerLevel.Add(totalPerLevel);
            }

            foreach (var niveau in niveaus)
            {
                var enabledQuestionsLevelSpecific = allEnabledQuestions
                    .Where(vraag => vraag.Element("niveau").Value == niveau)
                    .ToList();

                for (int i = 1; i <= totalsPerLevel.Min(); i++)
                {
                    randomIndex = RandomHelper.Next(0, enabledQuestionsLevelSpecific.Count());
                    xmlQuestions.Add(enabledQuestionsLevelSpecific[randomIndex]);
                    enabledQuestionsLevelSpecific.RemoveAt(randomIndex);
                }
            }

            count = xmlQuestions.Count();
            NiveauTestvragen = "mix";
        }
        else
        {
            xmlQuestions = allEnabledQuestions.FindAll(vraag => vraag.Element("niveau").Value == niveau);
            count = xmlQuestions.Count();
            NiveauTestvragen = niveau;
        }
    }

    private void KeuzeAantalTestVragen(ChangeEventArgs e)
    {
        XmlQuestionsSelection.Clear();
        currentQuestionIndex = 0;
        gekozenAantalTestvragen = e.Value.ToString();
        StateHasChanged();
        int aantaltestvragen;
        if (int.TryParse(e.Value.ToString(), out aantaltestvragen))
        {
            List<int> numbers = new();

            for (int i = 0; i < xmlQuestions.Count(); i++)
            {
                numbers.Add(i); 
            }
            for (int i = 0; i < aantaltestvragen; i++)
            {
                randomIndex = RandomHelper.Next(0, numbers.Count());

                XmlQuestionsSelection.Add(xmlQuestions[randomIndex]);
                XmlQuestionsSelection[i].Element("volgnummer").Value = i.ToString();
                numbers.RemoveAt(randomIndex); // voorkomt dat vraag twee keer wordt getrokken
            }
            //count = 0;
            
        }
        currentQuestionIndex = 0;
        gekozenAantalTestvragen = null;
        NaarVerwerking = true;
    }

    private void HandleAnswerSelection(string choice)
    {
        answer = choice;
        submitButtonText = "Antwoord met: " + answer;
    }

    private void Submit(XElement xElementQuestion)
    {
        if (answer == "")
        {
            submitButtonText = "Maak een keuze";
        }
        else
        {
            // userantwoord wordt in de vraag gezet die naar AI gaat
            xElementQuestion.Element("userantwoord").Value = answer;

            submitButtonText = "Maak een keuze";
            answer = "";

            if (currentQuestionIndex < XmlQuestionsSelection.Count)
            {
                currentQuestionIndex++;
            }
        }
    }

    private void Exit(int number)
    {
        int c = XmlQuestionsSelection.Count();
        XmlQuestionsSelection.RemoveRange(number, c - number);
    }
}

@if (ClearRadioButtons)
{
    gekozenTestNiveau = null;
    gekozenAantalTestvragen = null;
    StateHasChanged();
}

<!--parameter FileName wordt vanuit linkermenu met {} doorgegeven
// om de FN te verwerken moet hij eerst worden gestript
// als de user een nieuwe selectie binnen dezelfde vragenset maakt weten we dit omdat 
// de FN niet met een { start -->
@if (FileName.StartsWith('{'))
{
    // state vh object wordt gereset
    gekozenTestNiveau = null;
    gekozenAantalTestvragen = null;
    StateHasChanged();

    xmlQuestions.Clear();
    XmlQuestionsSelection.Clear();
    FileName = FileName.Replace("{", "").Replace("}", "");
    Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory);
    string fullpath = Path.Combine(Directory.GetCurrentDirectory() + "\\XmlQuestions\\", FileName);
    //var xmlString = File.ReadAllText(fullpath);
    root = XElement.Load(fullpath);
    NaamVragenSet = root.Element("vragenset").Value;
    paginaNaam = FileName.Replace(".xml", "");
}

<PageTitle>@paginaNaam</PageTitle>
<Style />
<div>
<span>


@if (true)
    {
        <span>&nbsp;&nbsp; Niveau:&nbsp;</span>
        @for (int i = 1; i <= 5; i++)
        {
            <label>
                    <input type="radio" id="@i" name="level" value="@i" @onchange="KeuzeTestNiveau" checked="@LevelSelected(i.ToString())" /> <span>&nbsp;@i&nbsp;</span>
            </label>
        }
            <span>&nbsp;&nbsp; Niveau Mix:&nbsp;</span>
                
        <label>
                <input type="radio" name="level" value="6" @onchange="KeuzeTestNiveau" checked="@LevelSelected("6")" /> mixed
        </label>
            <span>&nbsp;&nbsp;Aantal vragen:&nbsp;</span>
    }

</span>
<span>

    @if (count >= 50)
    {
        @for (int i = 5; i <= 50; i += 10)
        {
            <label>
                    <input type="radio" name="total" value="@i" @onchange="KeuzeAantalTestVragen" checked="@NumberOfQuestionsSelected(i.ToString())" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 25)
    {
        @for (int i = 5; i <= count; i += 5)
        {
            <label>
                    <input type="radio" name="total" value="@i" @onchange="KeuzeAantalTestVragen" checked="@NumberOfQuestionsSelected(i.ToString())" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 10)
    {
        @for (int i = 5; i <= count; i += 5)
        {
            <label>
                    <input type="radio" name="total" value="@i" @onchange="KeuzeAantalTestVragen" checked="@NumberOfQuestionsSelected(i.ToString())" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 5)
    {
        <label>
                <input type="radio" name="total" value="5" @onchange="KeuzeAantalTestVragen" checked="@NumberOfQuestionsSelected("5")" /> 5 &nbsp;
        </label>
    }

</span>
</div>

<hr />

@if (NaarVerwerking)
{
    gekozenAantalTestvragen = null;
    gekozenTestNiveau = null;
    //StateHasChanged();
    
    <div class="indexdiv">
        <h2 style="display: inline">@NaamVragenSet Vragenset</h2> Niveau @NiveauTestvragen
        <hr />

        <!-- Creates a question -->
        @if (XmlQuestionsSelection != null && currentQuestionIndex < XmlQuestionsSelection.Count)
        {
            var currentQuestion = XmlQuestionsSelection[currentQuestionIndex];
            int teller = 0;

            <p>@(currentQuestionIndex + 1)/@XmlQuestionsSelection.Count</p>
            <div>
                @foreach (var regel in currentQuestion.Element("header").Elements())
                {
                    if (teller == 0)
                    {
                        <h4>@regel.Value</h4>
                    }
                    else
                    {
                        if (regel.HasAttributes)
                        {
                            <div style="display: flex; justify-content:flex-start; align-items: center;">
                                <pre>@regel.Value</pre>
                            </div>
                        }
                        else
                        {
                            @regel.Value
                            <br />
                        }

                    }
                    teller++;
                }
            </div>

            <div>
                <br />
                <table>
                    @foreach (var choice in currentQuestion.Element("keuzes").Elements())
                    {
                        <tr>
                            <td>@choice.Name&nbsp;&nbsp;</td>
                            <td>
                                <button @onclick="() => HandleAnswerSelection(choice.Name.LocalName)" class="choice">
                                    @choice.Value
                                </button>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td colspan="2">
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <br />
                            <button @onclick="(args) => Submit(currentQuestion)" class="submit">@submitButtonText</button>
                        </td>
                    </tr>
                </table>
            </div>
            <hr />
            <!-- Tussentijds de vragenlijst afbreken met de exit knop -->
            <p><button @onclick="(args) => Exit(currentQuestionIndex)" class="submit">Exit</button></p>
        }



        else if (currentQuestionIndex == XmlQuestionsSelection.Count)
        {
            currentQuestionIndex = 0;
            <!--
            <h2>@nameVragenSet</h2>
            <hr />
            -->
            <CascadingValue Value="XmlQuestionsSelection">
                <Verwerking NaamVragenSet="@NaamVragenSet" NiveauTestvragen="@NiveauTestvragen" />
            </CascadingValue>
        }

    </div>
    
    
}
