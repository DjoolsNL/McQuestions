@page "/selectie/{fileName}"
@using System.Xml.Linq
@using System.Linq
@using System.Collections.Generic
@using System.IO

@code {
    [Parameter] public string FileName { get; set; }
    string pageTitle;
    string niveau;
    string NaamVragenSet;
    string selectedOption;
    int count = 0;
    int randomNumber;
    List<XElement> XmlQuestionsSelection = new();
    List<XElement> xmlQuestions = new();
    XElement root;
    bool ready;
    bool firstRun = true;
    bool radiobuttonLevel;

    private void OnChangeLevel(ChangeEventArgs e)
    {
        selectedOption = e.Value.ToString();
        StateHasChanged();
        XmlQuestionsSelection.Clear();
        niveau = e.Value.ToString();

        var allEnabledQuestions = root.Elements("vraag")
            .Distinct()
            .Where(e => e.Element("disabled").Value != "true")
            .ToList();

        xmlQuestions = allEnabledQuestions.FindAll(l => l.Element("niveau").Value == niveau);
        count = xmlQuestions.Count();
    }

    private void OnChangeNumberOfQuestions(ChangeEventArgs e)
    {
        int choice;
        if (int.TryParse(e.Value.ToString(), out choice))
        {
            for (int i = 0; i < choice; i++)
            {
                randomNumber = RandomHelper.Next(0, xmlQuestions.Count());
                xmlQuestions[randomNumber].Element("volgnummer").Value = i.ToString();
                XmlQuestionsSelection.Add(xmlQuestions[randomNumber]);
                xmlQuestions.RemoveAt(randomNumber);
            }
            ready = true;
        }
    }

    private bool IsOptionSelected(string optionValue)
    {
        return selectedOption == optionValue;
    }
}

@if (FileName.StartsWith('{'))
{
    if (!firstRun)
    {
        selectedOption = null;
        StateHasChanged();
    }

    firstRun = false;
    xmlQuestions.Clear();
    XmlQuestionsSelection.Clear();
    FileName = FileName.Replace("{", "").Replace("}", "");
    Directory.SetCurrentDirectory(AppDomain.CurrentDomain.BaseDirectory);
    string fullpath = Path.Combine(Directory.GetCurrentDirectory() + "\\XmlQuestions\\", FileName);
    var xmlString = File.ReadAllText(fullpath);
    root = XElement.Parse(xmlString);
    NaamVragenSet = root.Element("vragenset").Value;
    pageTitle = FileName.Replace(".xml", "");
}

<PageTitle>@pageTitle</PageTitle>
<Style />

<span>
    &nbsp;&nbsp; Niveau:
    @for (int i = 1; i <= 5; i++)
    {
        <label>
            <input type="radio" id="@i" name="level" value="@i" @onchange="OnChangeLevel" checked="@IsOptionSelected(i.ToString())" /> &nbsp;@i &nbsp;
        </label>
    }
</span>

<span>
    &nbsp;&nbsp; Niveau Mix:
    <label>
        <input type="radio" name="level" value="6" @onchange="OnChangeLevel" /> 1-5
    </label>
    &nbsp;- &nbsp;Aantal vragen:
</span>

<span>
    @if (count >= 50)
    {
        @for (int i = 5; i <= 50; i += 10)
        {
            <label>
                <input type="radio" name="total" value="@i" @onchange="OnChangeNumberOfQuestions" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 25)
    {
        @for (int i = 5; i <= 45; i += 10)
        {
            <label>
                <input type="radio" name="total" value="@i" @onchange="OnChangeNumberOfQuestions" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 10)
    {
        @for (int i = 5; i <= 10; i += 5)
        {
            <label>
                <input type="radio" name="total" value="@i" @onchange="OnChangeNumberOfQuestions" /> @i &nbsp;
            </label>
        }
    }
    else if (count >= 5)
    {
        <label>
            <input type="radio" name="total" value="5" @onchange="OnChangeNumberOfQuestions" /> 5 &nbsp;
        </label>
    }
</span>

<hr />

@if (ready)
{
    <div class="indexdiv">
        <CascadingValue Value="XmlQuestionsSelection">
            <Uitvoering NaamVragenSet="@NaamVragenSet" LevelQuestions="@niveau" />
        </CascadingValue>
    </div>
}
